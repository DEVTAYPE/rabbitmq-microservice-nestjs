{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/tienda/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "rspack",
    "tsConfigPath": "apps/tienda/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/tienda",
  "projects": {
    "notificaciones": {
      "type": "application",
      "root": "apps/notificaciones",
      "entryFile": "main",
      "sourceRoot": "apps/notificaciones/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notificaciones/tsconfig.app.json"
      }
    },
    "pagos": {
      "type": "application",
      "root": "apps/pagos",
      "entryFile": "main",
      "sourceRoot": "apps/pagos/src",
      "compilerOptions": {
        "tsConfigPath": "apps/pagos/tsconfig.app.json"
      }
    },
    "tienda": {
      "type": "application",
      "root": "apps/tienda",
      "entryFile": "main",
      "sourceRoot": "apps/tienda/src",
      "compilerOptions": {
        "tsConfigPath": "apps/tienda/tsconfig.app.json"
      }
    }
  }
}